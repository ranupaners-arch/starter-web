<section class="contact">
  <div class="invite">
    <h2>Butuh material kaca optik?</h2>
    <p>
      Ceritakan aplikasi dan spesifikasi yang Anda cari. Mulai konsultasi
      kebutuhan material dengan KukerEyes.
    </p>
  </div>
  <div class="contact-card">
    <a class="btn cta" href="https://wa.me/6282258442647">Konsultasi via WhatsApp</a>
    <span class="mono phone">0822 5844 2647</span>
  </div>
</section>

<style>
  .contact {
    display: flex;
    align-items: center;
    gap: 80px;
    width: 100%;
    padding: 72px var(--pad-x);
  }
  .invite {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  h2 {
    font-size: 46px;
    font-weight: 600;
    color: var(--color-ink);
  }
  .invite p {
    font-size: 20px;
    color: var(--color-muted);
  }
  .contact-card {
    width: 330px;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }
  .cta {
    width: 100%;
    padding: 16px 24px;
    font-size: 19px;
  }
  .phone {
    font-size: 14px;
    color: var(--color-muted);
  }
  @media (max-width: 900px) {
    .contact {
      flex-direction: column;
      align-items: flex-start;
      gap: 40px;
    }
    .contact-card {
      width: 100%;
      align-items: stretch;
      text-align: center;
    }
  }
</style>
